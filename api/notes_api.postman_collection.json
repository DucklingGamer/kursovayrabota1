    "name": "Notes API — КИМ 09.02.07-5-2027",
    "description": "Тесты для API GET /notes: 200, 400, 500, валидность JSON.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. GET /notes — 200 OK + валидный JSON",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// --- Тест 1: статус 200 ---",
              "pm.test(\"Статус 200 при штатной работе\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// --- Тест 2: валидность JSON ---",
              "pm.test(\"Ответ в формате JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "pm.test(\"Тело ответа — массив\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.be.an(\"array\");",
              "});",
              "",
              "// --- Тест 3: структура объектов ---",
              "pm.test(\"Каждый объект содержит обязательные поля\", function () {",
              "    const json = pm.response.json();",
              "    json.forEach(item => {",
              "        pm.expect(item).to.have.property(\"id\");",
              "        pm.expect(item).to.have.property(\"title_user\");",
              "        pm.expect(item).to.have.property(\"content\");",
              "        pm.expect(item).to.have.property(\"formatted_date\");",
              "    });",
              "});",
              "",
              "// --- Тест 4: формат даты ДД.ММ.ГГГГ ---",
              "pm.test(\"formatted_date в формате ДД.ММ.ГГГГ\", function () {",
              "    const re = /^\\\\d{2}\\\\.\\\\d{2}\\\\.\\\\d{4}$/;",
              "    pm.response.json().forEach(i => pm.expect(i.formatted_date).to.match(re));",
              "});",
              "",
              "// --- Тест 5: формат title_user ---",
              "pm.test(\"title_user в формате '{title} - {login}'\", function () {",
              "    const re = /^.+ - .+$/;",
              "    pm.response.json().forEach(i => pm.expect(i.title_user).to.match(re));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/notes",
          "host": ["{{base_url}}"],
          "path": ["notes"]
        },
        "description": "Штатный запрос. Проверяет 200 OK, валидный JSON, поля и форматы."
      }
    },
    {
      "name": "2. GET /notes?limit=abc — 400 Bad Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 400 при некорректном параметре\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Тело содержит error\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"error\");",
              "});",
              "",
              "pm.test(\"Ответ — валидный JSON\", function () {",
              "    pm.response.to.be.json;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/notes?limit=abc",
          "host": ["{{base_url}}"],
          "path": ["notes"],
          "query": [
            { "key": "limit", "value": "abc" }
          ]
        },
        "description": "Некорректное значение параметра → 400 Bad Request."
      }
    },
